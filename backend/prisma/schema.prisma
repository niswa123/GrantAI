generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ActivityType {
  COMPANY_CREATED
  COMPANY_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  ANALYSIS_RUN
  CLAIM_GENERATED
  CLAIM_UPDATED
  USER_INVITED
  USER_REMOVED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique @db.VarChar
  password_hash     String          @db.VarChar
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  companies         Company[]
  companyMemberships CompanyMember[]
  activityLogs      ActivityLog[]
  invitedMembers    CompanyMember[] @relation("InvitedBy")
  submissions       Submission[]

  @@map("users")
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  user_id       String         @db.Uuid
  name          String         @db.VarChar
  country       String         @db.VarChar
  industry      String         @db.VarChar
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects      Project[]
  expenses      Expense[]
  claims        Claim[]
  analysisRuns  AnalysisRun[]
  integrations  Integration[]
  members       CompanyMember[]
  activityLogs  ActivityLog[]
  submissions   Submission[]

  @@map("companies")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  title       String   @db.VarChar
  description String   @db.Text
  is_rd       Boolean  @default(false)
  rd_score    Float    @default(0.0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Expense {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  type           String   @db.VarChar
  amount         Decimal  @db.Decimal
  currency       String   @db.VarChar
  date           DateTime @db.Date
  description    String   @db.Text
  is_rd_related  Boolean  @default(false)
  created_at     DateTime @default(now())

  company        Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Claim {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  estimated_amount  Decimal  @db.Decimal
  rd_expenses_total Decimal  @db.Decimal
  status            String   @db.VarChar
  generated_text    String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company           Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  submissions       Submission[]

  @@map("claims")
}

model AnalysisRun {
  id               String   @id @default(uuid()) @db.Uuid
  company_id       String   @db.Uuid
  rd_score         Float    @default(0.0)
  estimated_amount Decimal  @db.Decimal
  details          Json     @db.JsonB
  created_at       DateTime @default(now())

  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("analysis_runs")
}

model Integration {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  provider         String    @db.VarChar
  access_token     String    @db.Text
  refresh_token    String?   @db.Text
  token_expires_at DateTime?
  metadata         Json?     @db.JsonB
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  company          Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, provider])
  @@index([company_id])
  @@map("integrations")
}

model CompanyMember {
  id          String      @id @default(uuid()) @db.Uuid
  company_id  String      @db.Uuid
  user_id     String      @db.Uuid
  role        CompanyRole @default(MEMBER)
  invited_by  String?     @db.Uuid
  joined_at   DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  company     Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  inviter     User?       @relation("InvitedBy", fields: [invited_by], references: [id], onDelete: SetNull)

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
  @@map("company_members")
}

model ActivityLog {
  id            String       @id @default(uuid()) @db.Uuid
  company_id    String       @db.Uuid
  user_id       String       @db.Uuid
  activity_type ActivityType
  entity_type   String?      @db.VarChar
  entity_id     String?      @db.Uuid
  description   String       @db.Text
  metadata      Json?        @db.JsonB
  created_at    DateTime     @default(now())

  company       Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@index([entity_type, entity_id])
  @@map("activity_logs")
}

enum SubmissionStatus {
  DRAFT
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum SubmissionFormat {
  PDF
  XML
  JSON
  CSV
  GOVERNMENT_PORTAL
}

model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  claim_id         String           @db.Uuid
  company_id       String           @db.Uuid
  country          String           @db.VarChar
  format           SubmissionFormat
  status           SubmissionStatus @default(DRAFT)
  reference_number String?          @db.VarChar
  submitted_at     DateTime?
  submitted_by     String?          @db.Uuid
  file_path        String?          @db.Text
  file_url         String?          @db.Text
  metadata         Json?            @db.JsonB
  notes            String?          @db.Text
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  claim            Claim            @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  submitter        User?            @relation(fields: [submitted_by], references: [id], onDelete: SetNull)

  @@index([claim_id])
  @@index([company_id])
  @@index([status])
  @@index([country])
  @@map("submissions")
}
