generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
  UNLIMITED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  NONE
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar
  password_hash String?  @db.VarChar // Nullable for OAuth users
  display_name  String?  @db.VarChar
  avatar_url    String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Subscription & Payment Fields
  subscription_tier      SubscriptionTier   @default(FREE)
  subscription_status    SubscriptionStatus @default(NONE)
  stripe_customer_id     String?            @unique @db.VarChar
  stripe_subscription_id String?            @unique @db.VarChar
  current_period_end     DateTime?

  // NextAuth fields
  name          String?
  emailVerified DateTime?
  image         String?

  companies       Company[] // Owned companies
  company_members CompanyMember[] // Companies they are members of
  audit_logs      AuditLog[]
  accounts        Account[] // OAuth accounts
  sessions        Session[] // User sessions
  payments        Payment[] // Stripe/NOWPayments history

  @@map("users")
}

// NextAuth Prisma Adapter Models
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid // Owner
  name                String   @db.VarChar
  country             String   @db.VarChar
  registration_number String?  @db.VarChar
  vat_number          String?  @db.VarChar
  city                String?  @db.VarChar
  address             String?  @db.Text
  default_hourly_rate Decimal  @default(50.0) @db.Decimal
  tax_credit_rate     Decimal  @default(0.14) @db.Decimal
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  claims             Claim[]
  members            CompanyMember[]
  integrations       Integration[]
  engineering_events EngineeringEvent[]
  analyzed_logs      AnalyzedLog[]
  daily_value_maps   DailyValueMap[]
  invites            WorkspaceInvite[]

  @@map("companies")
}

model CompanyMember {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  company_id  String   @db.Uuid
  role        String   @default("Viewer") @db.VarChar // Admin, Editor, Viewer
  status      String   @default("Pending") @db.VarChar // Active, Pending
  hourly_rate Decimal? @db.Decimal
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id])
  @@map("company_members")
}

model WorkspaceInvite {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar
  company_id String   @db.Uuid
  role       String   @default("Viewer") @db.VarChar
  token      String   @unique @db.VarChar
  expires_at DateTime
  created_at DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([email, company_id])
  @@map("workspace_invites")
}

model Claim {
  id         String  @id @default(uuid()) @db.Uuid
  company_id String? @db.Uuid

  // Input Data
  description       String  @db.Text
  total_salary_cost Decimal @db.Decimal
  total_dev_cost    Decimal @db.Decimal

  // Result Data
  estimated_rd_amount Decimal? @db.Decimal
  rd_score            Float?
  claim_text          String?  @db.Text
  status              String   @default("Draft") @db.VarChar
  fy_year             String   @default("2024") @db.VarChar

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company    Company?   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  audit_logs AuditLog[]

  @@map("claims")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  claim_id   String   @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar
  details    String?  @db.Text
  created_at DateTime @default(now())

  claim Claim @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  provider      String   @db.VarChar // "github", "jira", "linear"
  access_token  String   @db.Text
  refresh_token String?  @db.Text
  config        Json? // e.g., selected repositories or projects
  status        String   @default("active") @db.VarChar
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  company            Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  engineering_events EngineeringEvent[]

  @@unique([company_id, provider])
  @@map("integrations")
}

model EngineeringEvent {
  id             String  @id @default(uuid()) @db.Uuid
  company_id     String  @db.Uuid
  integration_id String? @db.Uuid

  event_type      String   @db.VarChar // "commit", "ticket_closed", "pr_merged"
  source_id       String   @db.VarChar // original ID from github/jira
  title           String   @db.Text
  description     String?  @db.Text
  author_email    String?  @db.VarChar
  event_timestamp DateTime

  raw_payload Json? // Store the raw webhook payload just in case

  status String @default("pending") @db.VarChar // pending, analyzed, failed

  created_at DateTime @default(now())

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integration_id], references: [id], onDelete: SetNull)
  analyzed_log AnalyzedLog?

  @@unique([integration_id, source_id])
  @@map("engineering_events")
}

model AnalyzedLog {
  id         String @id @default(uuid()) @db.Uuid
  event_id   String @unique @db.Uuid
  company_id String @db.Uuid

  is_rd             Boolean @default(false)
  confidence_score  Float   @db.DoublePrecision // 0.0 to 1.0
  complexity_weight Float   @db.DoublePrecision // 1.0 (normal) up to X.X
  justification     String? @db.Text // AI explanation why it is/isn't R&D
  calculated_value  Decimal @default(0) @db.Decimal // Generated value in €
  model_used        String? @db.VarChar // LLM model that produced this result

  // Feedback loop: user can override the AI classification
  user_override   Boolean? // null = no override, true = user says R&D, false = user says not R&D
  override_reason String?  @db.Text // User's explanation for the override

  created_at DateTime @default(now())

  event   EngineeringEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("analyzed_logs")
}

model DailyValueMap {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  date       DateTime @db.Date

  total_events Int     @default(0)
  rd_events    Int     @default(0)
  total_value  Decimal @default(0) @db.Decimal // Total € value for that day

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, date])
  @@map("daily_value_maps")
}

model Payment {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  provider            String   @db.VarChar // "stripe" or "nowpayments"
  external_payment_id String   @unique @db.VarChar
  amount              Decimal  @db.Decimal
  currency            String   @db.VarChar
  status              String   @db.VarChar // e.g., "succeeded", "pending", "failed"
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("payments")
}
