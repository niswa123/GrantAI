# ==================== APPLICATION ====================
NODE_ENV=development
PORT=3001
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000

# ==================== DATABASE ====================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/grantai_db?schema=public"

# ==================== AUTHENTICATION ====================
JWT_SECRET="your_super_secret_key_min_32_chars_change_in_production"
JWT_EXPIRES_IN="15m"

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== LLM API ====================
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_RETRIES=3

# ==================== MONITORING ====================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================== GITHUB OAUTH ====================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/integrations/github/callback

# ==================== JIRA OAUTH ====================
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_CALLBACK_URL=http://localhost:3001/api/v1/integrations/jira/callback

# ==================== RATE LIMITING ====================
# Throttler is configured in code, but you can override here if needed
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
